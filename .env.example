# Copiar a .env.local y completar

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
# Opcionales (S3). En algunos Windows el endpoint S3 falla TLS; usamos la API CF.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Token cfat_… de “Create Account API token” (pantalla post-creación)
CLOUDFLARE_API_TOKEN=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Cloudinary — mejora automática al subir fotos en admin (e_auto_enhance)
# Dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# false para subir directo a R2 sin pasar por Cloudinary
CLOUDINARY_ENHANCE=true

# Mercado Pago — Checkout Pro
# Credenciales de prueba: https://www.mercadopago.com.mx/developers/panel/app
# Access Token TEST-… para sandbox; APP_USR-… en producción
MP_ACCESS_TOKEN=
# Public Key solo si usas Brick/Wallet (Checkout Pro redirige con Access Token)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# PayPal — https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox: https://api-m.sandbox.paypal.com  |  Live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# App — producción: https://lenceriacleoh.com
NEXT_PUBLIC_SITE_URL=https://lenceriacleoh.com

# Google Search Console — verificación de propiedad (prefijo de URL, método "Etiqueta HTML")
# https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=

# Resend — correos de pedido pagado
# https://resend.com/api-keys
RESEND_API_KEY=
# Pruebas: Cleoh <onboarding@resend.dev>  |  Prod: dominio verificado
EMAIL_FROM=Cleoh <onboarding@resend.dev>
# Copia de cada pedido pagado (inbox tienda)
ORDER_NOTIFY_EMAIL=

# Meta Pixel (anuncios Facebook/Instagram) — Events Manager:
# https://business.facebook.com/events_manager2
# Si se deja vacío, el pixel simplemente no se carga (no rompe nada).
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API — respaldo server-side del evento Purchase (no depende del
# navegador/adblock). Events Manager → tu pixel → pestaña "Configuración" →
# sección "Conversions API" → "Generar token de acceso". Si se deja vacío,
# simplemente no se manda el evento server-side (el pixel del navegador sigue
# funcionando normal).
META_CAPI_ACCESS_TOKEN=

# Vercel Web Analytics en /admin/analiticas
# Token personal (prefijo vcp_): https://vercel.com/account/tokens
# No uses tokens vca_/vcr_ (Sign in with Vercel) — la API los rechaza.
VERCEL_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=prj_3jV3lCl9BBojqiFMCp72i9kdpBMJ
VERCEL_TEAM_ID=team_Fe3Ld4xrAgFma4ZNRHycwgUM
